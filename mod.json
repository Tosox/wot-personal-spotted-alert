{
    "id": "de.tosox.personal_spotted_alert",
    "version": "1.0.0",
    "name": "Personal Spotted Alert",
    "description": "Shows an icon next to the marker of each enemy you personally detect",
    "author": "Tosox",
    "website": "https://github.com/Tosox/wot-personal-spotted-alert",
    "prebuild": [
        ["python", "src_flash/build_swf.py"]
    ],
    "flash": {
        "main": "src_flash/src/PersonalSpottedAlertRoot.as",
        "output": "build/personal_spotted_alert.swf"
    },
    "extra_files": [
        { "src": "build/personal_spotted_alert.swf", "dst": "res/gui/flash/personal_spotted_alert.swf" },
        { "src": "README.md", "dst": "README.md" },
        { "src": "CHANGELOG.md", "dst": "CHANGELOG.md" },
        { "src": "LICENSE", "dst": "LICENSE" }
    ]
}
